# Puerto en el que corre la API
PORT=4000

# URL del frontend permitida por CORS
FRONTEND_URL=http://localhost:3000

# --- Base de datos (Neon / PostgreSQL) ---
# Pooled (host con -pooler) para la app en runtime.
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler/DBNAME?sslmode=require"
# Directa (host sin -pooler) para migraciones de Prisma.
DIRECT_URL="postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require"

# --- Autenticación (JWT) ---
JWT_SECRET=define-una-clave-secreta-larga-y-aleatoria
JWT_EXPIRES_IN=1d

# --- Admin semilla (reemplazar por base de datos más adelante) ---
ADMIN_EMAIL=admin@orthodonca.com
ADMIN_PASSWORD=Admin1234
ADMIN_NAME=Administrador

# --- Almacenamiento de imágenes (Cloudflare R2). Si se dejan vacías, fallback local. ---
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_URL=
PUBLIC_BACKEND_URL=http://localhost:4000

# --- Pasarela de pago (Stripe) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_SUCCESS_URL=http://localhost:3000/checkout/exito
STRIPE_CANCEL_URL=http://localhost:3000/checkout/cancelado
